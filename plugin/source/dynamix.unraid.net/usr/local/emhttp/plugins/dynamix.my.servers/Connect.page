<script>
const managedBackupApi = '/graphql/api/connect/managed-backup';
let managedBackupRecoveryPhrase = '';
let managedBackupPhraseMode = 'generated';
let managedBackupIsRotation = false;
let managedBackupPoll = null;

function generateManagedBackupPhrase() {
  const alphabet = 'abcdefghijklmnopqrstuvwxyz234567';
  const bytes = new Uint8Array(40);
  window.crypto.getRandomValues(bytes);
  const characters = Array.from(bytes, byte => alphabet[byte & 31]);
  const groups = [];
  for (let offset = 0; offset < characters.length; offset += 5) {
    groups.push(characters.slice(offset, offset + 5).join(''));
  }
  return groups.join('-');
}

function managedBackupPhraseIsUsable(phrase) {
  const byteLength = new TextEncoder().encode(phrase).byteLength;
  return byteLength >= 1 && byteLength <= 256 && phrase === phrase.trim() && !/[\p{Cc}\p{Cf}\p{Cs}\p{Co}\p{Cn}]/u.test(phrase);
}

async function managedBackupRequest(path, options) {
  const response = await fetch(managedBackupApi + path, {
    credentials: 'same-origin',
    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
    ...options,
  });
  const body = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(typeof body.message === 'string' ? body.message : _('Request failed'));
  return body;
}

function formatManagedBackupBytes(value) {
  if (!Number.isFinite(value) || value < 0) return _('Unavailable');
  const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
  let amount = value;
  let unit = 0;
  while (amount >= 1024 && unit < units.length - 1) {
    amount /= 1024;
    unit += 1;
  }
  return (unit === 0 ? amount.toFixed(0) : amount.toFixed(1)) + ' ' + units[unit];
}

function renderManagedBackupStatus(status) {
  $('#managed-backup-loading,#managed-backup-signed-out,#managed-backup-setup,#managed-backup-phrase,#managed-backup-ready,#managed-backup-error').hide();
  if (!status.signedIn) {
    $('#managed-backup-state').text(_('Sign in required')).removeClass('green').addClass('orange');
    $('#managed-backup-signed-out').show();
    return;
  }
  if (!status.configured) {
    $('#managed-backup-state').text(status.setupPending ? _('Finishing setup') : _('Not configured')).removeClass('green').addClass('orange');
    $('#managed-backup-setup').show();
    $('#managed-backup-migration-note').toggle(Boolean(status.legacyMigrationPending));
    return;
  }

  $('#managed-backup-state').text(status.running ? _('Backing up') : _('Ready')).removeClass('orange').addClass('green');
  $('#managed-backup-ready').show();
  $('#managed-backup-run').prop('disabled', Boolean(status.running));
  const job = status.job || {};
  $('#managed-backup-last-run').text(job.lastRunAt ? new Date(job.lastRunAt).toLocaleString() : _('Never'));
  $('#managed-backup-last-result').text(status.running ? _('Running') : (job.lastRunStatus || _('Not run')));
  if (status.usage && status.usage.state === 'current') {
    $('#managed-backup-usage').text(formatManagedBackupBytes(status.usage.value.usedBytes) + ' / ' + formatManagedBackupBytes(status.usage.value.quotaBytes));
  } else {
    $('#managed-backup-usage').text(_('Unavailable'));
  }
}

async function loadManagedBackupStatus() {
  try {
    renderManagedBackupStatus(await managedBackupRequest('/status', { method: 'GET' }));
  } catch (error) {
    $('#managed-backup-loading,#managed-backup-signed-out,#managed-backup-setup,#managed-backup-phrase,#managed-backup-ready').hide();
    $('#managed-backup-state').text(_('Unavailable')).removeClass('green').addClass('orange');
    $('#managed-backup-error-text').text(error.message || _('Managed backup is unavailable'));
    $('#managed-backup-error').show();
  }
}

function prepareManagedBackup(rotation = false) {
  managedBackupIsRotation = rotation;
  managedBackupPhraseMode = 'generated';
  managedBackupRecoveryPhrase = generateManagedBackupPhrase();
  $('#managed-backup-recovery-phrase').val(managedBackupRecoveryPhrase);
  $('#managed-backup-custom-phrase,#managed-backup-custom-confirmation').val('');
  $('#managed-backup-generated-option').prop('checked', true);
  $('#managed-backup-generated-fields').show();
  $('#managed-backup-custom-fields').hide();
  $('#managed-backup-phrase-title').text(rotation ? _('Change recovery phrase') : _('Create recovery phrase'));
  $('#managed-backup-rotation-note').toggle(rotation);
  $('#managed-backup-activate').text(rotation ? _('Add new recovery key') : _('Create encrypted backup'));
  $('#managed-backup-phrase-saved').prop('checked', false);
  $('#managed-backup-activate').prop('disabled', true);
  $('#managed-backup-phrase-error').hide();
  $('#managed-backup-setup').hide();
  $('#managed-backup-ready').hide();
  $('#managed-backup-phrase').show();
}

function selectManagedBackupPhraseMode(mode) {
  managedBackupPhraseMode = mode;
  if (mode === 'generated') {
    managedBackupRecoveryPhrase = generateManagedBackupPhrase();
    $('#managed-backup-recovery-phrase').val(managedBackupRecoveryPhrase);
  } else {
    managedBackupRecoveryPhrase = '';
  }
  $('#managed-backup-generated-fields').toggle(mode === 'generated');
  $('#managed-backup-custom-fields').toggle(mode === 'custom');
  $('#managed-backup-phrase-saved').prop('checked', false);
  $('#managed-backup-activate').prop('disabled', true);
  $('#managed-backup-phrase-error').hide();
}

function cancelManagedBackupPhrase() {
  managedBackupRecoveryPhrase = '';
  $('#managed-backup-recovery-phrase,#managed-backup-custom-phrase,#managed-backup-custom-confirmation').val('');
  $('#managed-backup-phrase').hide();
  if (managedBackupIsRotation) $('#managed-backup-ready').show();
  else $('#managed-backup-setup').show();
}

async function copyManagedBackupPhrase() {
  const input = document.getElementById('managed-backup-recovery-phrase');
  try {
    await navigator.clipboard.writeText(managedBackupRecoveryPhrase);
  } catch (_error) {
    input.focus();
    input.select();
    document.execCommand('copy');
  }
  $('#managed-backup-copy').text(_('Copied'));
}

async function activateManagedBackup() {
  const phrase = managedBackupPhraseMode === 'generated' ? managedBackupRecoveryPhrase : $('#managed-backup-custom-phrase').val();
  const confirmation = managedBackupPhraseMode === 'generated' ? phrase : $('#managed-backup-custom-confirmation').val();
  if (!$('#managed-backup-phrase-saved').is(':checked')) return;
  if (!managedBackupPhraseIsUsable(phrase)) {
    $('#managed-backup-phrase-error').text(_('Enter a recovery phrase without leading or trailing whitespace.')).show();
    return;
  }
  if (phrase !== confirmation) {
    $('#managed-backup-phrase-error').text(_('The recovery phrases do not match.')).show();
    return;
  }
  const button = $('#managed-backup-activate');
  button.prop('disabled', true).text(_('Preparing backup'));
  try {
    await managedBackupRequest('/setup', {
      method: 'POST',
      body: JSON.stringify({ recoveryPhrase: phrase }),
    });
    managedBackupRecoveryPhrase = '';
    $('#managed-backup-recovery-phrase,#managed-backup-custom-phrase,#managed-backup-custom-confirmation').val('');
    await loadManagedBackupStatus();
  } catch (error) {
    $('#managed-backup-phrase-error').text(error.message || _('Backup setup failed')).show();
    button.prop('disabled', false).text(managedBackupIsRotation ? _('Add new recovery key') : _('Create encrypted backup'));
  }
}

async function runManagedBackup() {
  const button = $('#managed-backup-run');
  button.prop('disabled', true).text(_('Starting'));
  try {
    await managedBackupRequest('/run', { method: 'POST', body: '{}' });
    await loadManagedBackupStatus();
    if (managedBackupPoll) window.clearInterval(managedBackupPoll);
    managedBackupPoll = window.setInterval(loadManagedBackupStatus, 3000);
  } catch (error) {
    $('#managed-backup-error-text').text(error.message || _('Backup could not be started'));
    $('#managed-backup-error').show();
  } finally {
    button.text(_('Back up now'));
  }
}

function applyExtraOrigins(button) {
  const postobj = {
      "#cfg": "/boot/config/plugins/dynamix.my.servers/myservers.cfg",
      "api_extraOrigins": validateExtraOrigins(),
  };

  $(button).prop("disabled", true).html("_(Applying)_ <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i>");
  $.post('/webGui/include/Dispatcher.php', postobj, function(_extraOriginsData) {
    window.location.reload();
  });
}

let isExtraOriginsValid = false;
const validateExtraOrigins = () => {
  const val = $('.js-extraOrigins').val();
  const $label = $('.js-extraOriginsLabel'); // setting here in this scope b/c it didn't work setting outside of this function
  if (!val) {
    $label.removeClass('red-text');
    isExtraOriginsValid = true;
    return '';
  }
  let trimmed = val.replace(/\s+/g, '');
  if (trimmed.slice(-1) === ',') trimmed = trimmed.slice(0, -1); // if last char is in string is a comma we need to remove it other wise `isCommaSeparatedURLs` will fail
  const isValid = isCommaSeparatedURLs(trimmed);
  if (!isValid) { // tell the user to fix it
    $label.addClass('red-text');
    isExtraOriginsValid = false;
    return '';
  }
  // remove any negative feedback
  $label.removeClass('red-text');
  isExtraOriginsValid = true;
  return trimmed;
};
const isCommaSeparatedURLs = input =>
  input
    .split(",")
    .every(value => /^(http|https):\/\/[^ "]+$/.test(value));

// toggle extra origins apply button
function extraOriginsValidateAndToggleDisabled() {
  validateExtraOrigins();
  if (!isExtraOriginsValid) {
    return $('.js-extraOriginsApply').prop("disabled",true);
  }
  return $('.js-extraOriginsApply').removeAttr('disabled');
}

$('body').on('change keyup', '.js-extraOrigins', function(data) {
  console.debug('change keyup', data);
  extraOriginsValidateAndToggleDisabled();
});

// Add the current URL to the Extra Origins setting on click then focus the input and automatically add the current window's origin
$('body').on('click', '.js-setCurrentHostExtraOrigins', function(e) {
  e.preventDefault();
  $extraOriginsInput = $('.js-extraOrigins');
  // if the curent window origin is already in the input, run the validation and enable the apply button
  if ($extraOriginsInput.val().includes(window.location.origin)) {
    return extraOriginsValidateAndToggleDisabled();
  }

  $extraOriginsInput.focus();
  if ($extraOriginsInput.val().length > 0) {
    // don't overwrite the value of the input, only add to it
    $extraOriginsInput.val($extraOriginsInput.val() + ', ' + window.location.origin);
  } else {
    // ensure the current window.location.origin is not already in the input before adding it
    $extraOriginsInput.val(window.location.origin);
  }
  // run the validation on the field and enable the apply button
  extraOriginsValidateAndToggleDisabled();
});
</script>

