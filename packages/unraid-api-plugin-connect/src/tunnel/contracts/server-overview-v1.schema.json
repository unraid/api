{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.myunraid.net/contracts/server-overview/v1.schema.json",
  "title": "Unraid Connect server overview v1",
  "description": "The non-PII, GraphQL-shaped server overview shared through Connect presence.",
  "type": "object",
  "required": ["schemaVersion", "info", "storage", "network"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "info": { "$ref": "#/$defs/info" },
    "storage": { "$ref": "#/$defs/storage" },
    "network": { "$ref": "#/$defs/network" },
    "notificationCounts": {
      "$ref": "#/$defs/notificationCounts",
      "description": "Normalized unread counts from notifications.overview.unread."
    }
  },
  "x-graphql-selection": "info { os { release uptime hostname } } storage { pools { id name kind state status fsType profile fsSize fsFree fsUsed warnings { code severity } drives { id name role state status fsSize fsFree fsUsed warnings { code severity } } } } network { accessUrls { type name url ipv4 ipv6 } } notifications { overview { unread { alert warning info total } } }",
  "$defs": {
    "info": {
      "type": "object",
      "required": ["os"],
      "additionalProperties": false,
      "properties": {
        "os": { "$ref": "#/$defs/os" }
      }
    },
    "os": {
      "type": ["object", "null"],
      "required": ["release", "uptime", "hostname"],
      "additionalProperties": false,
      "properties": {
        "release": { "type": ["string", "null"] },
        "uptime": { "type": ["string", "null"] },
        "hostname": { "type": ["string", "null"] }
      }
    },
    "storage": {
      "type": "object",
      "required": ["pools"],
      "additionalProperties": false,
      "properties": {
        "pools": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/pool" }
        }
      }
    },
    "pool": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "state",
        "status",
        "fsType",
        "profile",
        "fsSize",
        "fsFree",
        "fsUsed",
        "warnings",
        "drives"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "fsType": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "fsSize": { "type": ["number", "null"] },
        "fsFree": { "type": ["number", "null"] },
        "fsUsed": { "type": ["number", "null"] },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "drives": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/drive" }
        }
      }
    },
    "drive": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "state",
        "status",
        "fsSize",
        "fsFree",
        "fsUsed",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "fsSize": { "type": ["number", "null"] },
        "fsFree": { "type": ["number", "null"] },
        "fsUsed": { "type": ["number", "null"] },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string" }
      }
    },
    "network": {
      "type": "object",
      "required": ["accessUrls"],
      "additionalProperties": false,
      "properties": {
        "accessUrls": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessUrl" }
        }
      }
    },
    "accessUrl": {
      "type": "object",
      "required": ["type", "name", "url", "ipv4", "ipv6"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "ipv4": { "type": ["string", "null"] },
        "ipv6": { "type": ["string", "null"] }
      }
    },
    "notificationCounts": {
      "type": ["object", "null"],
      "required": ["alert", "warning", "info", "total"],
      "additionalProperties": false,
      "properties": {
        "alert": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warning": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "info": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
